k8s/mongodb/secret.yml

# Helm configuration containing secrets
Helm/values-prod.yaml
Helm/values-dev.yaml

# Terraform state and local files
*.tfstate
*.tfstate.*
.terraform/
crash.log
*.tfvars
*.tfvars.json
