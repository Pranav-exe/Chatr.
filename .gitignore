# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — NEVER commit real .env files
.env
*/.env
*.env.local
**/.env.local

# Ignore all .env.* variants...
.env.*
*/.env.*

# ...but always allow the example templates
!.env.example
!*/.env.example


# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
k8s/backend/secret.yml
k8s/mongodb/secret.yml

# Helm configuration containing secrets
Helm/values-prod.yaml
Helm/values-dev.yaml

# Terraform local files and state — never commit
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Terraform plan output
*.tfplan
**/plan.txt
