# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — NEVER commit real .env files
.env
*/.env
*.env.local
**/.env.local

# Ignore all .env.* variants...
.env.*
*/.env.*

# ...but always allow the example templates
!.env.example
!*/.env.example


